# Configuration globale Social Media Manager Monorepo
PORT=8080
MONGODB_URI=mongodb://mongodb:27017/social_media_manager

# MASTER_KEY pour le chiffrement AES-256-GCM des credentials sociaux (32 bytes = 64 caractères hexadécimaux ou chaîne de 32 caractères)
# Exemple de clé 32 octets (générée par ex: openssl rand -hex 32)
MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Log level
RUST_LOG=info,backend=debug

# Frontend port
FRONTEND_PORT=3000
